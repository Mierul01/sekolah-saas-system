# Copy this file to .env and fill in the values from your Firebase project settings
# (Firebase Console > Project settings > General > Your apps > SDK setup and configuration)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only staff signing in with an email ending in this domain are allowed in.
# Example: moe-dl.edu.my or smkatb.edu.my
VITE_ALLOWED_EMAIL_DOMAIN=example.edu.my

# Name shown in the header / login screen
VITE_SCHOOL_NAME=SMKA Tok Bachok

# Your own Google account email. Only this account can flip the system-wide
# lock switch (Profile > Developer Controls) that instantly blocks every
# other signed-in user from using the app — handy for pulling testers out
# once you're done, without touching the database or their accounts.
VITE_DEVELOPER_EMAIL=you@gmail.com
